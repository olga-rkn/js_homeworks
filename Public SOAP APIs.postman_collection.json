    {
      "name": "Book ISBN Numbers",
      "item": [
        {
          "name": "Is Valid ISBN13 Number",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response body contains element IsValidISBN13Result\", function () {",
                  "    pm.expect(pm.response.text()).to.include(\"<m:IsValidISBN13Result>\");",
                  "});",
                  "",
                  "pm.test(\"Response body contains element IsValidISBN13Response\", function () {",
                  "    pm.expect(pm.response.text()).to.include(\"m:IsValidISBN13Response\");",
                  "});",
                  "",
                  "var jsonObject = xml2Json(responseBody);",
                  "",
                  "pm.test(\"Response body contains element IsValidISBN13Result with value true\", function () {",
                  "    pm.expect(jsonObject['soap:Envelope']['soap:Body']['m:IsValidISBN13Response']['m:IsValidISBN13Result']).to.eql('true');",
                  "});",
                  "",
                  "pm.test(\"Response body contains element Envelope with attribute\", function () {",
                  "    pm.expect(pm.response.text()).to.include('encoding=\"utf-8\"');",
                  "});",
                  "",
                  "pm.test(\"Response body contains element Envelope with attribute\", function () {",
                  "    pm.expect(pm.response.text()).to.include('http://schemas.xmlsoap.org/soap/envelope/');",
                  "});",
                  "",
                  "pm.test(\"Response body contains element IsValidISBN13Response with attribute\", function () {",
                  "    pm.expect(pm.response.text()).to.include('http://webservices.daehosting.com/ISBN');",
                  "});",
                  "",
                  "pm.test('\"content-type\" is present in response headers', () => {",
                  "  pm.expect(pm.response.headers.has('content-type')).to.be.true;",
                  "});",
                  "",
                  "pm.test(\"Content-Type header is text/xml\", () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('text/xml');",
                  "});",
                  "",
                  "pm.test(\"Response time is less than 1500ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1500);",
                  "});",
                  "",
                  "pm.test(\"Response size is less than 900B\", function () {",
                  "    pm.expect(pm.response.responseSize).to.be.below(900);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml; charset=utf-8",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <IsValidISBN13 xmlns=\"http://webservices.daehosting.com/ISBN\">\n      <sISBN>978-1-4612-9090-2</sISBN>\n    </IsValidISBN13>\n  </soap:Body>\n</soap:Envelope>"
            },
            "url": {
              "raw": "http://webservices.daehosting.com/services/isbnservice.wso",
              "protocol": "http",
              "host": [
                "webservices",
                "daehosting",
